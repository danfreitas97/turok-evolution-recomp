{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "win-x64-debug",
      "displayName": "Windows x64 Debug (Ninja + MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release (Ninja + MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "win-x64-abicheck",
      "displayName": "Windows x64 Debug with the callee-saved register check",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TUROK_ABI_CHECK": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "win-x64-debug", "configurePreset": "win-x64-debug" },
    { "name": "win-x64-release", "configurePreset": "win-x64-release" },
    { "name": "win-x64-abicheck", "configurePreset": "win-x64-abicheck" }
  ]
}
